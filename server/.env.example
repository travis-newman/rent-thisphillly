PORT=4000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/base-app

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Set to true to skip real email sending; verification/reset links are
# logged to the console instead. When false, the SMTP_* vars below are required.
MAILER_DISABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM="Base App <no-reply@example.com>"

# Cloudflare R2 (photo storage). Optional — until these are set, photo
# upload/delete endpoints return 503 rather than blocking the app from
# starting. See the R2 setup steps in the project notes for how to get these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
